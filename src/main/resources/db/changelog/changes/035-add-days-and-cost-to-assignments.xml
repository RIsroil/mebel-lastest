<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="035-add-days-and-cost-to-assignments" author="Isroil">
    <addColumn tableName="furniture_assignments">
      <column name="days_worked" type="NUMERIC(4,2)">
        <constraints nullable="true"/>
      </column>
      <column name="allocated_labor_cost" type="NUMERIC(14,2)">
        <constraints nullable="true"/>
      </column>
    </addColumn>
    <rollback>
      <dropColumn tableName="furniture_assignments" columnName="days_worked"/>
      <dropColumn tableName="furniture_assignments" columnName="allocated_labor_cost"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
