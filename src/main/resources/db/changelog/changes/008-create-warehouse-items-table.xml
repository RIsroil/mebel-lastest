<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="008-create-warehouse-items-table" author="Isroil">
        <createTable tableName="warehouse_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workshop_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="unit_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(12,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="avg_unit_price" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_value" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="min_quantity_alert" type="DECIMAL(12,3)"/>
            <column name="sku" type="VARCHAR(50)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="UUID"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="warehouse_items" baseColumnNames="workshop_id"
                constraintName="fk_warehouse_items_workshop"
                referencedTableName="workshops" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
