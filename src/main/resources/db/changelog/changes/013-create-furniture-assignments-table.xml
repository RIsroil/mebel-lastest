<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="013-create-furniture-assignments-table" author="Isroil">
        <createTable tableName="furniture_assignments">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="furniture_order_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="worker_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="unassigned_at" type="TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="furniture_assignments" baseColumnNames="furniture_order_id"
                constraintName="fk_furniture_assignments_order"
                referencedTableName="furniture_orders" referencedColumnNames="id"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="furniture_assignments" baseColumnNames="worker_id"
                constraintName="fk_furniture_assignments_worker"
                referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
