<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="025-add-attendance-mode-to-workshops" author="Isroil">
        <addColumn tableName="workshops">
            <column name="attendance_mode" type="VARCHAR(20)" defaultValue="BUTTON_MODE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="025-add-is-manual-entry-to-daily-attendance" author="Isroil">
        <addColumn tableName="daily_attendance">
            <column name="is_manual_entry" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
