<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="017-create-earnings-table" author="Isroil">
        <createTable tableName="earnings">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="worker_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="workshop_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="earn_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="earn_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_id" type="UUID"/>
            <column name="hours_worked" type="DECIMAL(4,2)"/>
            <column name="hourly_rate" type="DECIMAL(12,2)"/>
            <column name="days_worked" type="DECIMAL(4,2)"/>
            <column name="daily_rate" type="DECIMAL(12,2)"/>
            <column name="furniture_order_id" type="UUID"/>
            <column name="commission_pct" type="DECIMAL(5,2)"/>
            <column name="commission_amount" type="DECIMAL(12,2)"/>
            <column name="base_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="is_paid" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="TIMESTAMP"/>
            <column name="paid_by" type="UUID"/>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="earnings" baseColumnNames="worker_id"
                constraintName="fk_earnings_worker"
                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="earnings" baseColumnNames="workshop_id"
                constraintName="fk_earnings_workshop"
                referencedTableName="workshops" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="earnings" baseColumnNames="attendance_id"
                constraintName="fk_earnings_attendance"
                referencedTableName="daily_attendance" referencedColumnNames="id"
                onDelete="SET NULL"/>
        <addForeignKeyConstraint
                baseTableName="earnings" baseColumnNames="furniture_order_id"
                constraintName="fk_earnings_furniture_order"
                referencedTableName="furniture_orders" referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
