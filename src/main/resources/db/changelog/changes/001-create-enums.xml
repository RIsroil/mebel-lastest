<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-enum-user-role" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE user_role AS ENUM ('ADMIN', 'OWNER', 'WORKER')</sql>
        <rollback><sql>DROP TYPE IF EXISTS user_role</sql></rollback>
    </changeSet>

    <changeSet id="001-create-enum-pay-type" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE pay_type AS ENUM ('HOURLY', 'DAILY', 'COMMISSION', 'HYBRID')</sql>
        <rollback><sql>DROP TYPE IF EXISTS pay_type</sql></rollback>
    </changeSet>

    <changeSet id="001-create-enum-unit-type" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE unit_type AS ENUM ('KG', 'GRAM', 'LITRE', 'ML', 'PIECE', 'METER', 'CM', 'M2', 'M3')</sql>
        <rollback><sql>DROP TYPE IF EXISTS unit_type</sql></rollback>
    </changeSet>

    <changeSet id="001-create-enum-transaction-type" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE transaction_type AS ENUM ('IN', 'OUT', 'ADJUSTMENT')</sql>
        <rollback><sql>DROP TYPE IF EXISTS transaction_type</sql></rollback>
    </changeSet>

    <changeSet id="001-create-enum-furniture-status" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE furniture_status AS ENUM ('DRAFT', 'IN_PROGRESS', 'COMPLETED', 'SOLD', 'CANCELLED')</sql>
        <rollback><sql>DROP TYPE IF EXISTS furniture_status</sql></rollback>
    </changeSet>

    <changeSet id="001-create-enum-earn-type" author="Isroil" dbms="postgresql">
        <sql>CREATE TYPE earn_type AS ENUM ('DAILY_WAGE', 'HOURLY_WAGE', 'COMMISSION', 'BONUS')</sql>
        <rollback><sql>DROP TYPE IF EXISTS earn_type</sql></rollback>
    </changeSet>

</databaseChangeLog>
