<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="018-create-bonuses-table" author="Isroil">
        <createTable tableName="bonuses">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="worker_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="workshop_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="earning_id" type="UUID"/>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="bonus_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="UUID"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="bonuses" baseColumnNames="worker_id"
                constraintName="fk_bonuses_worker"
                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="bonuses" baseColumnNames="workshop_id"
                constraintName="fk_bonuses_workshop"
                referencedTableName="workshops" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="bonuses" baseColumnNames="earning_id"
                constraintName="fk_bonuses_earning"
                referencedTableName="earnings" referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
